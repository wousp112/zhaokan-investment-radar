  "chapters": [
    {
      "id": "intro",
      "title": "把关注条件，变成持续检查",
      "start": 0.0,
      "end": 9.7,
      "sentences": [
        "有自选股，却没时间一直盯盘。",
        "照看把你的关注条件保存下来，持续检查，有变化时留下依据。"
      ]
    },
    {
      "id": "write",
      "title": "先写清楚，关注什么",
      "start": 9.7,
      "end": 20.067,
      "sentences": [
        "在新建提醒里，直接选用一个示例。",
        "未来两周，贵州茅台下跌达到百分之三，或发布业绩预告，就提醒我。"
      ]
    },
    {
      "id": "ai",
      "title": "AI 整理，用户核对",
      "start": 20.067,
      "end": 29.8,
      "sentences": [
        "需要帮助时，可以让AI整理这段文字。",
        "系统会说明文字发给谁。AI生成草稿，核对后才能开启。"
      ]
    },
    {
      "id": "review",
      "title": "每一项条件，都能检查",
      "start": 29.8,
      "end": 39.367,
      "sentences": [
        "点击下一步，核对公司和比较方式。",
        "这里的达到，包含正好百分之三。条件和结束时间都能修改。"
      ]
    },
    {
      "id": "activate",
      "title": "确认之后，才开始检查",
      "start": 39.367,
      "end": 47.767,
      "sentences": [
        "确认并开启提醒，任务才开始检查。",
        "以后也能暂停、修改，或归档保留记录。"
      ]
    },
    {
      "id": "no-trigger",
      "title": "没有提醒，也有明确原因",
      "start": 47.767,
      "end": 58.733,
      "sentences": [
        "打开检查记录。模拟跌幅只有百分之一点二，未达到设定条件。",
        "也没有发现新公告。为什么没有提醒，每一项都有依据。"
      ]
    },
    {
      "id": "trigger",
      "title": "条件满足，保存一条提醒",
      "start": 58.733,
      "end": 68.7,
      "sentences": [
        "进入演示体验，点击下跌至百分之三点八。",
        "条件满足，一条提醒已经保存。以下价格都是模拟数据。"
      ]
    },
    {
      "id": "dedup",
      "title": "持续检查，减少重复打扰",
      "start": 68.7,
      "end": 76.233,
      "sentences": [
        "继续下跌，提醒仍然只有一条。",
        "同一条件已经提醒，本次就不再重复。"
      ]
    },
    {
      "id": "pending",
      "title": "新公告先保留",
      "start": 76.233,
      "end": 83.667,
      "sentences": [
        "提醒间隔内，出现新的业绩预告。",
        "检查继续进行，公告先保留下来。"
      ]
    },
    {
      "id": "deliver",
      "title": "间隔结束，补发公告",
      "start": 83.667,
      "end": 92.5,
      "sentences": [
        "推进这条模拟任务的时钟，三十一分钟。",
        "公告重新判断后补发，条件提醒变成两条。"
      ]
    },
    {
      "id": "failure",
      "title": "数据异常，说明受影响的判断",
      "start": 92.5,
      "end": 100.633,
      "sentences": [
        "模拟行情超时，界面显示数据待恢复。",
        "数据不可用时，不拿旧价格下结论。"
      ]
    },
    {
      "id": "recovery",
      "title": "恢复之后，继续监控",
      "start": 100.633,
      "end": 108.567,
      "sentences": [
        "来源恢复以后，监控继续。",
        "数据异常和恢复，也会分别保存在提醒记录里。"
      ]
    },
    {
      "id": "feedback",
      "title": "打开提醒，核对当时的依据",
      "start": 108.567,
      "end": 117.533,
      "sentences": [
        "打开一条提醒，查看当时的价格和判断。",
        "还可以反馈有用、打扰太多，或者判断有误。"
      ]
    },
    {
      "id": "version",
      "title": "修改条件，保留旧的判断",
      "start": 117.533,
      "end": 127.467,
      "sentences": [
        "把当前阈值改为百分之四，保存为新版本。",
        "旧通知仍保留原先百分之三的条件，历史判断不会被改写。"
      ]
    },
    {
      "id": "report",
      "title": "演示与真实，分开统计",
      "start": 127.467,
      "end": 135.667,
      "sentences": [
        "运行情况里，模拟和真实记录分开查看。",
        "没有真实样本，就明确显示暂无记录。"
      ]
    },
    {
      "id": "outro",
      "title": "从一条能解释的提醒开始",
      "start": 135.667,
      "end": 146.233,
      "sentences": [
        "目前提供站内提醒，真实公告覆盖仍有限。",
        "试用时，从示例开始，核对条件，再到提醒记录查看结果。"
      ]
    }
