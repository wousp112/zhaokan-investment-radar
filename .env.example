# Optional: IFIND_SCRIPT=/absolute/path/to/configured/call-node.js
RADAR_AI_ENABLED=1
RADAR_ALLOW_LIVE=1
RADAR_SCHEDULER=1
RADAR_SECURE_COOKIE=0
# Optional: RADAR_DATA_DIR=/absolute/path/to/persistent/data
